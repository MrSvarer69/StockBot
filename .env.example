# Copy to .env and fill in your Alpaca paper-trading keys.
# Get them at: https://app.alpaca.markets/paper/dashboard/overview

ALPACA_API_KEY=
ALPACA_API_SECRET=

# Default endpoint is paper. Do not change unless you know what you're doing.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# "paper" or "live". Code refuses to start in "live" without risk-officer approval.
TRADING_MODE=paper

# Default symbol universe for the opening-range strategy.
SYMBOLS=SPY,QQQ,IWM

# SEC EDGAR fair-access policy requires a descriptive User-Agent of the form
# "Name email@example.com". Used by the Form 4 backfill (scripts/backfill_form4.py).
SEC_USER_AGENT=
